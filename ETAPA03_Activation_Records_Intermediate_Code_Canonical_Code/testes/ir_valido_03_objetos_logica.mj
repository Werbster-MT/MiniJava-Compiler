class ObjetosLogica {
  public static void main(String[] a) {
    System.out.println(new Calc().run(3, 4));
  }
}

class Calc {
  public int run(int x, int y) {
    int z;
    z = 0;
    if ((x < y) && !(x < 0))
      z = this.add(x, y);
    else
      z = 1;
    return z;
  }

  public int add(int a, int b) {
    return a + b;
  }
}
